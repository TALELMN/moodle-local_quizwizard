{{!
    Question editor modal.
}}
<div class="modal fade" id="qw-question-modal" tabindex="-1" role="dialog" aria-labelledby="qw-question-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content qw-modal">
            <div class="modal-header">
                <h4 class="modal-title" id="qw-question-modal-label">{{#str}} addquestion, local_quizwizard {{/str}}</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{#str}} close, local_quizwizard {{/str}}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="qw-question-form">
                    <input type="hidden" name="questionid" id="qw-question-id" value="0">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">

                    <div class="qw-form-group">
                        <label for="qw-question-text">{{#str}} question, local_quizwizard {{/str}}</label>
                        <textarea id="qw-question-text" name="questiontext" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="qw-form-group qw-checkbox">
                        <input type="checkbox" id="qw-single" name="single" value="1" checked>
                        <label for="qw-single">{{#str}} singleanswer, local_quizwizard {{/str}}</label>
                    </div>

                    <div class="qw-form-group">
                        <label>{{#str}} answers, local_quizwizard {{/str}}</label>
                        <div id="qw-answers-container">
                            <div class="qw-answer-row">
                                <input type="text" name="answertext[]" class="form-control" placeholder="{{#str}} answer, local_quizwizard {{/str}} A">
                                <label class="qw-correct-toggle">
                                    <input type="checkbox" name="correct[]" value="1">
                                    <span>{{#str}} correct, local_quizwizard {{/str}}</span>
                                </label>
                            </div>
                            <div class="qw-answer-row">
                                <input type="text" name="answertext[]" class="form-control" placeholder="{{#str}} answer, local_quizwizard {{/str}} B">
                                <label class="qw-correct-toggle">
                                    <input type="checkbox" name="correct[]" value="1">
                                    <span>{{#str}} correct, local_quizwizard {{/str}}</span>
                                </label>
                            </div>
                            <div class="qw-answer-row">
                                <input type="text" name="answertext[]" class="form-control" placeholder="{{#str}} answer, local_quizwizard {{/str}} C">
                                <label class="qw-correct-toggle">
                                    <input type="checkbox" name="correct[]" value="1">
                                    <span>{{#str}} correct, local_quizwizard {{/str}}</span>
                                </label>
                            </div>
                            <div class="qw-answer-row">
                                <input type="text" name="answertext[]" class="form-control" placeholder="{{#str}} answer, local_quizwizard {{/str}} D">
                                <label class="qw-correct-toggle">
                                    <input type="checkbox" name="correct[]" value="1">
                                    <span>{{#str}} correct, local_quizwizard {{/str}}</span>
                                </label>
                            </div>
                        </div>
                        <button type="button" class="btn btn-link" id="qw-add-answer-btn">{{#str}} addanswer, local_quizwizard {{/str}}</button>
                    </div>

                    <div class="qw-form-row">
                        <div class="qw-form-group">
                            <label for="qw-points">{{#str}} points, local_quizwizard {{/str}}</label>
                            <input type="number" id="qw-points" name="points" class="form-control" value="1" min="0.1" step="0.1">
                        </div>
                        <div class="qw-form-group">
                            <label for="qw-difficulty">{{#str}} difficulty, local_quizwizard {{/str}}</label>
                            <select id="qw-difficulty" name="difficulty" class="form-control">
                                <option value="">{{#str}} none, local_quizwizard {{/str}}</option>
                                <option value="easy">{{#str}} difficulty_easy, local_quizwizard {{/str}}</option>
                                <option value="medium">{{#str}} difficulty_medium, local_quizwizard {{/str}}</option>
                                <option value="hard">{{#str}} difficulty_hard, local_quizwizard {{/str}}</option>
                            </select>
                        </div>
                        <div class="qw-form-group">
                            <label for="qw-category">{{#str}} category, local_quizwizard {{/str}}</label>
                            <input type="text" id="qw-category" name="category" class="form-control">
                        </div>
                    </div>

                    <div class="qw-form-group">
                        <label for="qw-explanation">{{#str}} explanation, local_quizwizard {{/str}}</label>
                        <textarea id="qw-explanation" name="explanation" class="form-control" rows="2"></textarea>
                    </div>
                </form>
                <div id="qw-question-error" class="alert alert-danger" role="alert" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">{{#str}} cancel, local_quizwizard {{/str}}</button>
                <button type="button" class="btn btn-primary qw-btn-large" id="qw-save-question-btn">{{#str}} savequestion, local_quizwizard {{/str}}</button>
            </div>
        </div>
    </div>
</div>
