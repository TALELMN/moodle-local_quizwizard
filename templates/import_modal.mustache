{{!
    Import modal.
}}
<div class="modal fade" id="qw-import-modal" tabindex="-1" role="dialog" aria-labelledby="qw-import-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content qw-modal">
            <div class="modal-header">
                <h4 class="modal-title" id="qw-import-modal-label">{{#str}} importquestions, local_quizwizard {{/str}}</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{#str}} close, local_quizwizard {{/str}}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="qw-import-tabs">
                    <button type="button" class="btn btn-secondary active" data-import-tab="file">{{#str}} importcsv, local_quizwizard {{/str}}</button>
                    <button type="button" class="btn btn-secondary" data-import-tab="paste">{{#str}} importpaste, local_quizwizard {{/str}}</button>
                </div>

                <div class="qw-import-panel" id="qw-import-file">
                    <p class="qw-help-text">Upload a CSV or Excel file with columns: question, answer1, answer2, ..., correct, explanation, points, difficulty.</p>
                    <input type="file" id="qw-import-file-input" accept=".csv,.xlsx,.xls" class="form-control">
                </div>

                <div class="qw-import-panel" id="qw-import-paste" style="display:none;">
                    <p class="qw-help-text">Paste CSV content with the same columns.</p>
                    <textarea id="qw-import-paste-input" class="form-control" rows="8"></textarea>
                </div>

                <div id="qw-import-preview" style="display:none;">
                    <h5>{{#str}} previewimport, local_quizwizard {{/str}}</h5>
                    <div id="qw-import-preview-list"></div>
                </div>

                <div id="qw-import-error" class="alert alert-danger" role="alert" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">{{#str}} cancel, local_quizwizard {{/str}}</button>
                <button type="button" class="btn btn-secondary" id="qw-preview-import-btn">{{#str}} previewimport, local_quizwizard {{/str}}</button>
                <button type="button" class="btn btn-primary qw-btn-large" id="qw-import-selected-btn" style="display:none;">{{#str}} importselected, local_quizwizard {{/str}}</button>
            </div>
        </div>
    </div>
</div>
